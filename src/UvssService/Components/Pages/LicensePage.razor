@page "/license"
@rendermode InteractiveServer
@using UvssService.Licensing
@inject LicenseStore LicenseStore
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>License - ANPR</PageTitle>

<div class="p-4 max-w-[700px] mx-auto flex flex-col gap-4">
    <h1 class="text-base font-bold tracking-wide text-[#222]">LICENSE</h1>

    <div class="bg-white border border-[#ccc] rounded overflow-hidden">
        <div class="px-4 py-3 border-b border-[#ccc] bg-[#ececec]">
            <h2 class="text-xs font-bold tracking-wide text-[#222]">THIS DEVICE</h2>
        </div>
        <div class="p-4 flex flex-col gap-2">
            <label class="text-xs font-semibold text-[#555]">Device ID -- send this to your vendor to get a license key</label>
            <div class="flex items-center gap-2">
                <input value="@LicenseStore.DeviceId" readonly
                       class="border border-[#ccc] rounded px-2 py-1.5 text-sm bg-[#f5f5f5] font-mono flex-1" />
                <button class="bg-[#1a5fb4] text-white px-3 py-1.5 rounded text-xs font-semibold cursor-pointer" @onclick="CopyDeviceId">
                    @(_copied ? "Copied!" : "Copy")
                </button>
            </div>
        </div>
    </div>

    <div class="bg-white border border-[#ccc] rounded overflow-hidden">
        <div class="px-4 py-3 border-b border-[#ccc] bg-[#ececec]">
            <h2 class="text-xs font-bold tracking-wide text-[#222]">STATUS</h2>
        </div>
        <div class="p-4 flex flex-col gap-1.5">
            <span class="flex items-center gap-1.5 font-bold text-sm @StatusColorClass">
                <span class="w-2.5 h-2.5 rounded-full inline-block @StatusDotClass"></span>
                @StatusLabel
            </span>
            <p class="text-xs text-[#555]">@LicenseStore.Status.Message</p>
            @if (!string.IsNullOrEmpty(LicenseStore.Status.Customer))
            {
                <p class="text-xs text-[#777]">Licensed to: @LicenseStore.Status.Customer</p>
            }
        </div>
    </div>

    <div class="bg-white border border-[#ccc] rounded overflow-hidden">
        <div class="px-4 py-3 border-b border-[#ccc] bg-[#ececec]">
            <h2 class="text-xs font-bold tracking-wide text-[#222]">ACTIVATE / RENEW</h2>
        </div>
        <div class="p-4 flex flex-col gap-3">
            <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-[#555]">License Key</label>
                <textarea @bind="_licenseKeyInput" rows="4" placeholder="Paste the license key your vendor gave you"
                          class="border border-[#ccc] rounded px-2 py-1.5 text-xs font-mono resize-none"></textarea>
            </div>
            @if (!string.IsNullOrEmpty(_saveMessage))
            {
                <p class="text-xs font-semibold @(_saveOk ? "text-[#2c7a2c]" : "text-[#c23b1f]")">@_saveMessage</p>
            }
            <div>
                <button class="bg-[#1a5fb4] text-white px-3.5 py-1.5 rounded text-sm font-semibold cursor-pointer hover:bg-[#164e93]" @onclick="SaveLicenseKey">
                    Save License Key
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private string _licenseKeyInput = "";
    private string _saveMessage = "";
    private bool _saveOk;
    private bool _copied;

    protected override void OnInitialized() => LicenseStore.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void SaveLicenseKey()
    {
        if (string.IsNullOrWhiteSpace(_licenseKeyInput))
        {
            _saveMessage = "Paste a license key first.";
            _saveOk = false;
            return;
        }
        LicenseStore.SetLicenseKey(_licenseKeyInput);
        _saveOk = LicenseStore.IsValid;
        _saveMessage = _saveOk ? "License key saved and verified." : $"License key saved, but it isn't valid -- {LicenseStore.Status.Message}";
    }

    private async Task CopyDeviceId()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", LicenseStore.DeviceId);
            _copied = true;
        }
        catch
        {
            _copied = false;
        }
    }

    private string StatusLabel => LicenseStore.Status.State switch
    {
        LicenseState.Valid => "LICENSED",
        LicenseState.Expired => "EXPIRED",
        LicenseState.DeviceMismatch => "WRONG DEVICE",
        LicenseState.Invalid => "INVALID KEY",
        _ => "NOT LICENSED",
    };

    private string StatusColorClass => LicenseStore.IsValid ? "text-[#2c7a2c]" : "text-[#c23b1f]";
    private string StatusDotClass => LicenseStore.IsValid ? "bg-[#39d353]" : "bg-[#c23b1f]";

    public void Dispose() => LicenseStore.Changed -= OnChanged;
}
