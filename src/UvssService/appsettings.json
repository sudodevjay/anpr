{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "CameraDefaults": {
    "Username": "",
    "Password": "",
    "SnapshotPath": "/axis-cgi/jpg/image.cgi",
    "SnapshotResolution": "1920x1080",
    "SnapshotCompression": 10,
    "SnapshotTimeoutSeconds": 6,
    "StreamIntervalMs": 150
  },

  "Storage": {
    "Enabled": true,
    "VehicleImageDir": "captured_vehicle"
  },

  "BackendEvent": {
    "EventUrl": "http://localhost:5003/api/anpr/events",
    "TimeoutSeconds": 8,
    "EventToken": ""
  }
}
